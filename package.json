{
  "name": "xoumyax-portfolio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --ignore-lock --port ${PORT:-4321}",
    "test:unit": "vitest run",
    "typecheck": "astro sync && tsc --noEmit",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=\"${PW_BROWSERS:-$(git rev-parse --path-format=absolute --git-common-dir)/../.pw-browsers}\" playwright test",
    "test": "npm run test:unit && npm run typecheck && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.4.12",
    "gray-matter": "^4.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "fast-glob": "^3.3.3",
    "typescript": "^7.0.2",
    "unpdf": "^2.2.1",
    "vitest": "^5.1.0"
  }
}
