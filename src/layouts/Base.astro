---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/fraunces';
import '../styles/global.css';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import { hasPosterFile, posterUrl } from '../lib/poster';

interface Props {
  title: string;
  description: string;
  theme?: 'paper' | 'night' | 'world';
  noindex?: boolean;
}
const { title, description, theme = 'paper', noindex = false } = Astro.props;
const fullTitle = title === 'Soumyajyoti Dutta' ? title : `${title} — Soumyajyoti Dutta`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// M13: the world poster is every page's social preview image (1440×900)
const ogImage = hasPosterFile('poster.webp') ? new URL(posterUrl('poster.webp'), Astro.site) : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {ogImage && <>
      <meta property="og:image" content={ogImage} />
      <meta property="og:image:type" content="image/webp" />
      <meta property="og:image:width" content="1440" />
      <meta property="og:image:height" content="900" />
      <meta property="og:image:alt" content="An ASCII diorama of a desert road in Big Bend, drawn in coloured characters" />
    </>}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="theme-color" content={theme === 'night' ? '#0B0B0C' : theme === 'world' ? '#E9DCC4' : '#F5F2EC'} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%231D1B18'/%3E%3Ctext x='16' y='22' font-family='monospace' font-size='16' fill='%23F0A43A' text-anchor='middle'%3ESD%3C/text%3E%3C/svg%3E" />
    <slot name="head" />
  </head>
  <body data-theme={theme}>
    <a href="#main" class="skip">Skip to content</a>
    <TopBar />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
  </body>
</html>
