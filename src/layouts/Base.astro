---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/fraunces';
import '../styles/global.css';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  theme?: 'paper' | 'night' | 'world' | 'ascii';
  noindex?: boolean;
  /** The ASCII home (/): send a visitor who chose the pixel style to /road/ before paint. */
  artRedirect?: boolean;
  /** Canonical path when it is not this page's own (the pixel home points at /). */
  canonicalPath?: string;
}
const { title, description, theme = 'paper', noindex = false, artRedirect = false, canonicalPath } = Astro.props;
const fullTitle = title === 'Soumyajyoti Dutta' ? title : `${title} — Soumyajyoti Dutta`;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
// The hero scene (1440×810) is every page's social preview image
const ogImage = new URL('/og.png', Astro.site);
// Browser-chrome colour per theme; mode.ts rewrites both metas when the visitor picks a mode.
const bar = theme === 'night' ? { light: '#0B0B0C', dark: '#0B0B0C' }
  : theme === 'world' ? { light: '#E9DCC4', dark: '#24201A' }
  : theme === 'ascii' ? { light: '#F5F2EC', dark: '#171512' }
  : { light: '#F5F2EC', dark: '#171512' };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {artRedirect && (
      <script is:inline>
        // Art style (Mode II / Mode I): ?style=ascii or the switch stores the choice; a stored
        // 'pixel' sends / to /road/, keeping the query and the #stop-<id> deep link.
        try {
          var q = new URLSearchParams(location.search);
          if (q.get('style') === 'ascii') {
            localStorage.setItem('art-style', 'ascii');
            q.delete('style');
            var rest = q.toString();
            history.replaceState(history.state, '', location.pathname + (rest ? '?' + rest : '') + location.hash);
          } else if (localStorage.getItem('art-style') === 'pixel') {
            // Leaving: the page's own head scripts check this and fetch nothing (no poster preload).
            document.documentElement.setAttribute('data-leaving', '');
            location.replace('/road/' + location.search + location.hash);
          }
        } catch (e) {}
      </script>
    )}
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        var m = localStorage.getItem('mode');
        if (m === 'dark' || m === 'light') document.documentElement.setAttribute('data-mode', m);
      } catch (e) {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1440" />
    <meta property="og:image:height" content="810" />
    <meta property="og:image:alt" content="A pixel-art painting of a Big Bend desert landscape" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="theme-color" content={bar.light} media="(prefers-color-scheme: light)" data-light={bar.light} data-dark={bar.dark} />
    <meta name="theme-color" content={bar.dark} media="(prefers-color-scheme: dark)" data-light={bar.light} data-dark={bar.dark} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%231D1B18'/%3E%3Ctext x='16' y='22' font-family='monospace' font-size='16' fill='%23F0A43A' text-anchor='middle'%3ESD%3C/text%3E%3C/svg%3E" />
    <slot name="head" />
  </head>
  <body data-theme={theme}>
    <a href="#main" class="skip">Skip to content</a>
    <TopBar />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
  </body>
</html>
