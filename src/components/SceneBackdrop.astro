---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { SCENE_IDS, sceneUrl } from '../lib/scenes';
// Scenes with a layered world on disk; the client fetches only these, so a scene without one never 404s.
const worlds = SCENE_IDS.filter((id) => existsSync(join(process.cwd(), 'public', 'scenes', id, 'scene.json'))).join(' ');
---
<div class="scenes" aria-hidden="true" data-worlds={worlds}>
  <picture>
    <source media="(orientation: portrait)" srcset={sceneUrl('hero', 'port')} />
    <img src={sceneUrl('hero', 'land')} alt="" width="240" height="135" decoding="async" fetchpriority="high" />
  </picture>
  <canvas id="scene" hidden></canvas>
</div>

<style>
  .scenes {
    /* Large-viewport height: a phone's URL bar sliding away must not resize the backdrop. */
    position: fixed; top: 0; left: 0; right: 0; z-index: -1;
    height: 100vh; height: 100lvh;
    overflow: hidden; pointer-events: none;
    background: var(--storm);
    filter: var(--scene-filter);
  }
  .scenes img {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; image-rendering: pixelated;
  }
  .scenes canvas {
    position: absolute; left: 50%; top: 50%;
    transform: translate(-50%, -50%);
    max-width: none; image-rendering: pixelated;
  }
  .scenes canvas[hidden] { display: none; }
</style>
