---
import { sceneUrl } from '../lib/scenes';
---
<div class="scenes" aria-hidden="true">
  <picture>
    <source media="(orientation: portrait)" srcset={sceneUrl('hero', 'port')} />
    <img src={sceneUrl('hero', 'land')} alt="" width="240" height="135" decoding="async" fetchpriority="high" />
  </picture>
  <canvas id="scene" hidden></canvas>
</div>

<style>
  .scenes {
    position: fixed; inset: 0; z-index: -1;
    overflow: hidden; pointer-events: none;
    background: var(--storm);
  }
  .scenes img {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; image-rendering: pixelated;
  }
  .scenes canvas {
    position: absolute; left: 50%; top: 50%;
    transform: translate(-50%, -50%);
    max-width: none; image-rendering: pixelated;
  }
  .scenes canvas[hidden] { display: none; }
</style>
