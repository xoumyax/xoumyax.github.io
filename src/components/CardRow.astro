---
// A horizontal, natively scrolling, snapping row. Card sizing lives here so any card
// component (ProjectCard or TextCard) drops in without its own width.
interface Props { label: string }
const { label } = Astro.props;
---
<div class="card-row" data-card-row role="region" aria-label={label} tabindex="0">
  <slot />
</div>

<style>
  .card-row {
    --card-w: min(17rem, 78vw);
    --card-tilt: 0;
    display: flex; gap: 1rem;
    min-width: 0; max-width: 100%;
    margin-top: 1.25rem;
    padding: .9rem .9rem 1.4rem;
    overflow-x: auto; overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: .9rem;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
    scrollbar-color: color-mix(in oklab, var(--ink) 35%, transparent) transparent;
    pointer-events: auto;
  }
  .card-row > :global(*) { flex: 0 0 var(--card-w); width: var(--card-w); scroll-snap-align: start; }
  /* Desktop: rows share the panels' left column so each stop's landmark stays clear on the right. */
  @media (min-width: 960px) { .card-row { max-width: min(100%, 40rem); } }
  .card-row:focus-visible { outline-offset: 2px; border-radius: 1rem; }
</style>
