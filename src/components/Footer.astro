---
// Contact details come from profile.yaml and the CV path from config.yaml (the single sources, M17).
import { getConfig, getProfile } from '../lib/data';
import ArtSwitch from './ArtSwitch.astro';

const { name, email, github, linkedin } = getProfile();
const { cvPdf } = getConfig();
const year = new Date().getFullYear();
// The pixel home (/road/) keeps its art style switch here on narrow screens (see ArtSwitch.astro).
const road = Astro.url.pathname.replace(/\/$/, '') === '/road';
---
<footer class="footer">
  <div class="wrap row">
    <span>© {year} {name}</span>
    {road && <ArtSwitch current="pixel" place="page" />}
    <span class="links">
      <a href={`mailto:${email}`}>Email</a>
      <a href={github} rel="noopener">GitHub</a>
      <a href={linkedin} rel="noopener">LinkedIn</a>
      {cvPdf && <a href={cvPdf}>Full CV (PDF)</a>}
    </span>
  </div>
</footer>

<style>
  .footer { padding: 2.5rem 0; font-size: .9rem; border-top: 1px solid color-mix(in oklab, currentColor 12%, transparent); }
  .row { display: flex; flex-wrap: wrap; gap: 1rem 2rem; justify-content: space-between; }
  .links { display: flex; flex-wrap: wrap; gap: 1.25rem; }
</style>
