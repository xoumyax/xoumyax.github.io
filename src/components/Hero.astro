---
import YaraikibaCard from './YaraikibaCard.astro';
import './journey/panel.css';

interface Props {
  name: string; role: string; openToWork: string;
  yaraikiba: { url: string; steps: string[]; blurb: string };
}
const { name, role, openToWork, yaraikiba } = Astro.props;
---
<section class="hero" data-section aria-labelledby="hero-name">
  <div class="wrap grid">
    <div class="panel intro" data-panel>
      <h1 id="hero-name">{name}</h1>
      <p class="role">{role}</p>
      <p class="open"><span class="dot" aria-hidden="true"></span><span>{openToWork}</span></p>
      <a class="start" href="#stop-srm">Travel the road <span aria-hidden="true">↓</span></a>
    </div>
    <YaraikibaCard {...yaraikiba} />
  </div>
</section>

<style>
  .hero {
    min-height: calc(100svh - var(--bar-h));
    display: flex; align-items: flex-end;
    padding-block: clamp(2rem, 18vh, 12rem) clamp(2rem, 8vh, 5rem);
    pointer-events: none;
  }
  .grid {
    display: grid; gap: clamp(1rem, 2.5vw, 2rem);
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    align-items: end;
  }
  @media (max-width: 56rem) { .grid { grid-template-columns: minmax(0, 1fr); } }
  h1 { font-size: clamp(2.1rem, 8.5vw, 5.5rem); overflow-wrap: break-word; margin-bottom: .35em; }
  .role { font-size: clamp(1.05rem, 1.8vw, 1.3rem); line-height: 1.45; max-width: 46ch; }
  .open {
    display: flex; gap: .6rem; align-items: baseline;
    font-family: var(--font-mono); font-size: .88rem; letter-spacing: .01em; line-height: 1.5;
    max-width: 60ch; margin-bottom: 1.4rem;
  }
  .dot {
    flex: none; width: .6rem; height: .6rem; border-radius: 50%; background: var(--amber);
    box-shadow: 0 0 0 .25rem color-mix(in oklab, var(--amber) 30%, transparent);
    transform: translateY(-.05rem);
  }
  .start { font-size: .95rem; font-weight: 550; }
</style>
