---
// A tilted cover card that settles flat on hover/focus. It fills its container's width, so it
// works in the /projects grid and in a scroll-snap row. Set `--card-tilt: 0` on an ancestor to
// keep cards flat (e.g. inside a clipped scroller); the default is 1.
import type { Project } from '../lib/schema';
import ProjectCover from './ProjectCover.astro';
import { tiltFor } from './projects/util';

interface Props {
  project: Project;
}
const { project } = Astro.props;
---
<a class="pcard" href={`/projects/${project.slug}/`} style={tiltFor(project.slug)} data-card aria-label={`${project.title} — ${project.oneLiner}`}>
  <ProjectCover project={project} size="card">
    <div class="top mono">
      <span>{project.years}</span>
      <span class="status">{project.statusLabel}</span>
    </div>
    <div class="caption">
      <h3>{project.title}</h3>
      <p>{project.oneLiner}</p>
    </div>
  </ProjectCover>
</a>

<style>
  .pcard {
    --rest-shadow:
      0 1px 2px color-mix(in oklab, var(--ink) 12%, transparent),
      0 18px 34px -18px color-mix(in oklab, var(--ink) 45%, transparent);
    display: block; width: 100%;
    color: inherit; text-decoration: none;
    border-radius: 14px;
    box-shadow: var(--rest-shadow);
    transition: transform .8s var(--ease), box-shadow .6s var(--ease);
    -webkit-tap-highlight-color: transparent;
  }
  /* Tilt only when motion is welcome; flat is the default. */
  @media (prefers-reduced-motion: no-preference) {
    .pcard {
      transform: perspective(1100px) rotate3d(var(--tx), var(--ty), 1, calc(var(--ta) * var(--card-tilt, 1))) scale(1);
      will-change: transform;
    }
    .pcard:hover, .pcard:focus-visible {
      transform: perspective(1100px) rotate3d(var(--tx), var(--ty), 1, 0deg) scale(1.025);
    }
  }
  /* Colour-fringe drop shadow: rust and storm split apart on either side, amber below. */
  .pcard:hover, .pcard:focus-visible {
    box-shadow:
      -9px 6px 0 -3px color-mix(in oklab, var(--rust) 55%, transparent),
      9px 4px 0 -3px color-mix(in oklab, var(--storm) 50%, transparent),
      -18px 16px 30px -8px color-mix(in oklab, var(--rust) 70%, transparent),
      18px 12px 30px -8px color-mix(in oklab, var(--storm) 70%, transparent),
      0 30px 46px -20px color-mix(in oklab, var(--amber) 95%, transparent),
      0 1px 2px color-mix(in oklab, var(--ink) 14%, transparent);
  }
  .pcard:focus-visible { outline: 2px solid var(--ink); outline-offset: 5px; }

  .top {
    position: absolute; inset: .85rem 1rem auto;
    display: flex; justify-content: space-between; gap: 1rem;
    font-size: .7rem; letter-spacing: .04em; line-height: 1.3;
  }
  .status { text-align: right; max-width: 60%; }

  .caption {
    position: absolute; inset: auto 0 0;
    padding: 2.5rem 1.1rem 1.1rem;
    background: linear-gradient(to top, var(--tone) 55%, color-mix(in oklab, var(--tone) 0%, transparent));
  }
  h3 {
    margin: 0 0 .45rem;
    font-size: clamp(1.6rem, 2.4vw, 2rem); font-weight: 700;
    letter-spacing: -0.045em; line-height: .95;
    overflow-wrap: anywhere;
  }
  p {
    margin: 0; font-size: .86rem; line-height: 1.35;
    display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden;
  }
</style>
