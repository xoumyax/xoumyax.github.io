---
// Mode II identity card: who, what, open to work, one row of links, and YARAikiba folded into a
// dropdown (its sign-in steps open on demand).
import { inlineMd } from '../journey/inline-md';
import './m2.css';

interface Props {
  name: string; role: string; openToWork: string;
  email: string; github: string; linkedin: string; resumePdf: string; cvPdf: string;
  yaraikiba: { url: string; steps: string[]; blurb: string };
}
const { name, role, openToWork, email, github, linkedin, resumePdf, cvPdf, yaraikiba } = Astro.props;
---
<div class="idcol">
  <section class="m2-glass id" aria-labelledby="hero-name">
    <h1 id="hero-name">{name}</h1>
    <p class="role">{role}</p>
    <p class="open"><span class="dot" aria-hidden="true"></span><span>{openToWork}</span></p>
    <ul class="links" aria-label="Contact and documents">
      <li><a href={`mailto:${email}`}>Email</a></li>
      <li><a href={github} rel="noopener">GitHub</a></li>
      <li><a href={linkedin} rel="noopener">LinkedIn</a></li>
      <li><a href={resumePdf} download>Resume</a></li>
      <li><a href={cvPdf}>CV</a></li>
    </ul>
  </section>

  <section class="m2-glass yaraikiba" aria-labelledby="yk-title">
    <p class="m2-kicker">Live demo · guest access</p>
    <h2 id="yk-title">Try YARAikiba</h2>
    <p class="blurb">{yaraikiba.blurb}</p>
    <p class="actions">
      <a class="go" href={yaraikiba.url} rel="noopener" target="_blank">Open YARAikiba ↗<span class="visually-hidden"> (opens in a new tab)</span></a>
      <a href="/projects/yaraikiba/">How it works</a>
    </p>
    <details class="m2-drop" data-yk-steps>
      <summary>Guest sign-in, {yaraikiba.steps.length} steps</summary>
      <ol>
        {yaraikiba.steps.map((s) => <li set:html={inlineMd(s)} />)}
      </ol>
    </details>
  </section>
</div>

<style>
  .idcol { display: grid; gap: .9rem; align-content: start; min-width: 0; }
  .id, .yaraikiba { padding: clamp(1.1rem, 2.4vw, 1.6rem); }
  h1 { font-size: clamp(2rem, 3.6vw, 2.9rem); margin-bottom: .4rem; overflow-wrap: break-word; }
  .role { font-size: 1rem; line-height: 1.45; margin-bottom: .7rem; }
  .open {
    display: flex; gap: .6rem; align-items: baseline;
    font-family: var(--font-mono); font-size: .8rem; line-height: 1.5; margin-bottom: .9rem;
  }
  .dot {
    flex: none; width: .55rem; height: .55rem; border-radius: 50%; background: var(--amber);
    box-shadow: 0 0 0 .22rem color-mix(in oklab, var(--amber) 30%, transparent);
    transform: translateY(-.05rem);
  }
  .links {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: .3rem;
    font: 600 .74rem/1 var(--font-mono); letter-spacing: .01em;
  }
  .links a {
    display: inline-block; padding: .55rem .6rem; border-radius: 999px; text-decoration: none;
    border: 1px solid color-mix(in oklab, var(--ink) 24%, transparent);
    transition: background-color .2s var(--ease);
  }
  .links a:hover { background: color-mix(in oklab, var(--amber) 28%, transparent); }

  h2 { font-size: 1.3rem; margin-bottom: .3rem; }
  .blurb { font-size: .92rem; line-height: 1.45; margin-bottom: .75rem; }
  .actions { display: flex; flex-wrap: wrap; gap: .5rem 1rem; align-items: center; margin-bottom: .6rem; font-size: .9rem; }
  .go {
    padding: .5rem .95rem; border-radius: 999px; text-decoration: none; font-weight: 600;
    background: var(--amber); color: var(--char);
  }
  .go:hover { background: color-mix(in oklab, var(--amber) 80%, var(--char)); }
  ol { margin: .5rem 0 0; padding: 0; list-style: none; counter-reset: step; font-size: .88rem; }
  ol > li { counter-increment: step; position: relative; padding: .25rem 0 .25rem 1.9rem; }
  ol > li::before {
    content: counter(step); font-family: var(--font-mono); font-size: .7rem;
    position: absolute; left: 0; top: .3rem;
    width: 1.35rem; height: 1.35rem; border-radius: 50%; display: grid; place-items: center;
    background: var(--ink); color: var(--paper);
  }
  ol > li :global(strong) { font-weight: 650; }
</style>
