---
// Scratch card: the content is always in the page (and read by screen readers); with JS and
// motion welcome, an aria-hidden foil covers it until it is scratched away, the Reveal button is
// pressed, or keyboard focus lands on a link underneath. Reduced motion or no JS: shown as is.
import './m2.css';
---
<div class="scratch" data-scratch>
  <div class="sheet">
    <div class="body" data-scratch-body tabindex="-1">
      <slot />
    </div>
    <div class="cover" data-scratch-cover aria-hidden="true">
      <canvas></canvas>
      <p class="hint"><span>Scratch to see what I'm looking for</span></p>
    </div>
  </div>
  <button type="button" class="reveal" data-reveal>Reveal<span class="visually-hidden"> what I'm looking for</span></button>
</div>

<style>
  .scratch { min-width: 0; }
  .sheet { position: relative; }
  .body { border-radius: .9rem; padding: .9rem 1rem 1rem; border: 1px dashed color-mix(in oklab, var(--ink) 28%, transparent); }
  .body:focus { outline: none; }
  .body:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .cover, .reveal { display: none; }
  /* The foil: inverted ink on paper, so it reads as a separate surface in both modes. */
  .cover {
    position: absolute; inset: 0;
    border-radius: .9rem; overflow: hidden;
    background: color-mix(in oklab, var(--ink) 92%, var(--paper));
    color: var(--paper);
    transition: opacity .45s var(--ease);
    touch-action: none; cursor: crosshair;
  }
  .cover canvas { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; }
  .cover.painted { background: transparent; }
  .hint {
    position: absolute; inset: 0; margin: 0; padding: 1rem;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: center; text-align: center; gap: .3rem .7rem;
    font: 600 .82rem/1.4 var(--font-mono); letter-spacing: .03em;
    pointer-events: none; transition: opacity .3s var(--ease);
  }
  .hint span {
    padding: .45rem .8rem; border-radius: 999px;
    background: color-mix(in oklab, var(--ink) 92%, var(--paper));
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--paper) 30%, transparent);
  }
  .scratch.started .hint { opacity: 0; }
  .reveal {
    margin-top: .6rem; padding: .45rem .9rem; border-radius: 999px; cursor: pointer;
    font: 600 .78rem/1 var(--font-mono); letter-spacing: .05em; text-transform: uppercase;
    border: 1px solid color-mix(in oklab, var(--ink) 30%, transparent);
    background: transparent; color: var(--ink);
  }
  .reveal:hover { background: color-mix(in oklab, var(--ink) 10%, transparent); }
  .reveal:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .scratch:not(.revealed) .cover { display: block; }
    :global(.js) .scratch:not(.revealed) .reveal { display: inline-block; }
  }
  .scratch.fading .cover { display: block; opacity: 0; pointer-events: none; }
</style>
