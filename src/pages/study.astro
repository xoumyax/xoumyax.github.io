---
import Base from '../layouts/Base.astro';
import { getStudy } from '../lib/data';

const s = getStudy();
---
<Base title="Study" description="Interview-prep and job-search study sites." theme="paper">
  <div class="wrap page">
    <h1>Study</h1>
    <p class="lede">Sites I use for interview prep and the job search.</p>
    <ul class="cards">
      {s.links.map((l) => (
        <li>
          <a href={l.href} target="_blank" rel="noopener noreferrer">
            <strong>{l.title}</strong>
            <span>{l.blurb}</span>
            <span class="mono host">{new URL(l.href).hostname} ↗</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .page { max-width: var(--measure); padding-block: 2rem 3rem; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); margin-bottom: .3em; }
  .lede { margin: 0 0 1.5rem; }
  .cards { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; }
  .cards a { display: grid; gap: .3rem; padding: 1rem 1.1rem; border: 1px solid var(--ink); border-radius: 4px; text-decoration: none; color: inherit; background: var(--sand); transition: border-color .2s var(--ease), transform .2s var(--ease); }
  .cards a:hover, .cards a:focus-visible { border-color: var(--amber); transform: translateY(-2px); outline: 2px solid var(--amber); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .cards a:hover, .cards a:focus-visible { transform: none; } }
  .host { opacity: .7; overflow-wrap: anywhere; }
</style>
