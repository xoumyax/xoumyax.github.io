---
import type { GetStaticPaths } from 'astro';
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCover from '../../components/ProjectCover.astro';
import Metric from '../../components/Metric.astro';
import { AREA_LABELS, wallOrder } from '../../components/projects/util';
import { getJourney, getProjects } from '../../lib/data';
import type { Project } from '../../lib/schema';
import { stopForProject } from '../../lib/journey';

export const getStaticPaths = (async () => {
  const projects = wallOrder(await getProjects());
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, prev: projects[i - 1], next: projects[i + 1] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
  prev?: Project;
  next?: Project;
}
const { project, prev, next } = Astro.props;

const entry = await getEntry('projects', project.slug);
if (!entry) throw new Error(`projects collection has no entry for "${project.slug}"`);
const { Content } = await render(entry);

// Link to the stop that actually shows this project; fall back to its own `stop` field.
const journey = getJourney();
const stopId = stopForProject(journey, project.slug) ?? project.stop;
const stop = journey.stops.find((s) => s.id === stopId);
if (!stop) throw new Error(`${project.slug}: unknown journey stop "${stopId}"`);
---
<Base title={project.title} description={project.oneLiner} theme="paper">
  <article class="detail" style={`--tone: var(--${project.cover.tone})`}>
    <header class="wrap head">
      <a class="pill back" href="/projects/"><span aria-hidden="true">←</span> All projects</a>
      <p class="meta mono">
        {project.venue && <><span class="venue" data-venue>{project.venue}</span><span aria-hidden="true"> · </span></>}
        <span>{project.statusLabel}</span>
        <span aria-hidden="true"> · </span>
        <span>{project.years}</span>
      </p>
      <h1>{project.title}</h1>
      <p class="lede">{project.oneLiner}</p>
      <ul class="tags" aria-label="Areas">
        {project.areas.map((a) => <li><a class="pill" href={`/projects/?area=${a}`}>{AREA_LABELS[a]}</a></li>)}
      </ul>
      {project.links.length > 0 && (
        <ul class="links" aria-label="Links">
          {project.links.map((l) => (
            <li><a class="pill solid" href={l.href} target="_blank" rel="noopener noreferrer">{l.label} <span aria-hidden="true">↗</span></a></li>
          ))}
        </ul>
      )}
    </header>

    <div class="wrap visual">
      <ProjectCover project={project} size="hero" />
    </div>

    {project.metrics.length > 0 && (
      <section class="wrap numbers" aria-label="Key numbers">
        {project.metrics.map((m) => <Metric value={m.value} label={m.label} />)}
      </section>
    )}

    {project.sponsors.length > 0 && (
      <p class="wrap sponsors"><span class="mono">Sponsored by</span> {project.sponsors.join(' · ')}</p>
    )}

    <div class="wrap body">
      <div class="prose"><Content /></div>
    </div>

    <footer class="wrap foot">
      <a class="journey" href={`/#stop-${stop.id}`}>
        <span class="mono">On the journey:</span>
        <span class="stop">{stop.title}</span>
        <span class="mono yrs">{stop.years} <span aria-hidden="true">→</span></span>
      </a>
      <nav class="pager" aria-label="More projects">
        {prev ? <a class="pill" href={`/projects/${prev.slug}/`}><span aria-hidden="true">←</span> {prev.title}</a> : <span />}
        {next && <a class="pill" href={`/projects/${next.slug}/`}>{next.title} <span aria-hidden="true">→</span></a>}
      </nav>
    </footer>
  </article>
</Base>

<style>
  .detail { overflow-x: clip; padding-bottom: clamp(3rem, 8vw, 6rem); }

  .pill {
    display: inline-flex; align-items: center; gap: .4rem;
    padding: .45rem .9rem; border-radius: 999px;
    font-size: .9rem; font-weight: 500; text-decoration: none; color: var(--ink);
    border: 1px solid color-mix(in oklab, var(--ink) 18%, transparent);
    transition: background-color .25s var(--ease), border-color .25s var(--ease), color .25s var(--ease);
  }
  .pill:hover { background: color-mix(in oklab, var(--ink) 7%, transparent); border-color: color-mix(in oklab, var(--ink) 35%, transparent); }
  .pill.solid { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .pill.solid:hover { background: var(--amber); color: var(--char); border-color: var(--amber); }

  .head { padding-block: clamp(1.5rem, 4vw, 3rem) clamp(1.5rem, 4vw, 2.5rem); }
  .back { margin-bottom: clamp(1.5rem, 5vw, 3.5rem); }
  .meta { margin: 0 0 1rem; font-size: .8rem; letter-spacing: .03em; color: color-mix(in oklab, var(--ink) 75%, transparent); }
  .venue {
    display: inline-block; padding: .15rem .55rem; border-radius: 999px;
    background: var(--amber); color: var(--char);
  }
  h1 {
    margin: 0 0 .25em;
    font-size: clamp(3.2rem, 11.5vw, 10.5rem); font-weight: 650;
    letter-spacing: -0.065em; line-height: .86;
    margin-left: -0.04em;
    overflow-wrap: anywhere;
  }
  .lede {
    max-width: 38rem; margin: 0 0 1.5rem;
    font-size: clamp(1.15rem, 2vw, 1.5rem); font-weight: 500; line-height: 1.3; letter-spacing: -0.015em;
  }
  .tags, .links { list-style: none; padding: 0; margin: 0 0 .6rem; display: flex; flex-wrap: wrap; gap: .4rem; }

  .visual { margin-block: clamp(1rem, 3vw, 2rem) clamp(2.5rem, 6vw, 4.5rem); }

  .numbers {
    display: grid; gap: clamp(1.5rem, 3vw, 2.5rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }
  .sponsors { margin-block: -1.5rem 3rem; font-weight: 550; }
  .sponsors .mono { font-weight: 400; opacity: .7; margin-right: .4rem; }

  .body { display: grid; }
  .prose { max-width: var(--measure); }
  .prose :global(h2) {
    margin: 2.6rem 0 .8rem;
    font-size: clamp(2rem, 4.5vw, 3.25rem); font-weight: 650; letter-spacing: -0.05em; line-height: .95;
  }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(p), .prose :global(li) { font-size: 1.08rem; line-height: 1.6; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.2rem; }
  .prose :global(a) { text-decoration-color: color-mix(in oklab, var(--ink) 40%, transparent); }
  .prose :global(a:hover) { text-decoration-color: var(--amber); }
  .prose :global(code) { font-family: var(--font-mono); font-size: .9em; }
  @media (min-width: 64rem) {
    .body { grid-template-columns: minmax(0, 14rem) minmax(0, 1fr); }
    .prose { grid-column: 2; }
  }

  .foot { margin-top: clamp(3rem, 8vw, 6rem); display: grid; gap: 2rem; }
  .journey {
    display: grid; gap: .35rem; padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: 22px; text-decoration: none; color: var(--ink);
    background: var(--sand);
    transition: background-color .3s var(--ease);
  }
  /* char on amber is the same pairing as .pill.solid:hover: readable in both modes */
  .journey:hover { background: var(--amber); color: var(--char); }
  .journey .mono { font-size: .8rem; opacity: .75; }
  .journey .stop { font-size: clamp(1.6rem, 4vw, 2.8rem); font-weight: 650; letter-spacing: -0.045em; line-height: 1; }
  .pager { display: flex; justify-content: space-between; gap: .75rem; flex-wrap: wrap; }
</style>
